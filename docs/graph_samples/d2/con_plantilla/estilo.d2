# Plantilla compartida: cada diagrama la importa con `...@estilo` en la primera línea y usa
# sus clases con `class: nombre`.
classes: {
  # Nodos finales de un flujo.
  error: {style.fill: "#fde2e2"}
  ok: {style.fill: "#e2f5e2"}
  # Relaciones «include» y «extend» de los casos de uso.
  dependencia: {style.stroke-dash: 4}
}
