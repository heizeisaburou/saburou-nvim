# Diagrama de casos de uso del sitio personal: quién hace qué con él, desde que se escribe
# una entrada hasta que alguien la lee.
vars: {
  d2-config: {
    layout-engine: elk
  }
}
direction: right

autor: Autor {shape: person}
visitante: Visitante {shape: person}
ci: GitHub Actions {shape: person}

sitio: Sitio personal {
  escribir: Escribir una entrada {shape: oval}
  previsualizar: Previsualizar en local {shape: oval}
  regenerar: Regenerar sólo\nlo que cambió {shape: oval}
  publicar: Publicar el sitio {shape: oval}
  generar: Generar el sitio\ncompleto {shape: oval}
  leer: Leer una entrada {shape: oval}
  idioma: Cambiar de idioma {shape: oval}
  navegar: Seguir entradas\nrelacionadas {shape: oval}

  previsualizar -> regenerar: «include» {style.stroke-dash: 4}
  publicar -> generar: «include» {style.stroke-dash: 4}
  idioma -> leer: «extend» {style.stroke-dash: 4}
  navegar -> leer: «extend» {style.stroke-dash: 4}
}

autor -- sitio.escribir
autor -- sitio.previsualizar
autor -- sitio.publicar
ci -- sitio.publicar
visitante -- sitio.leer
visitante -- sitio.idioma
visitante -- sitio.navegar
